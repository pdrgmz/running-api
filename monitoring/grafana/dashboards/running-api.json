{
  "dashboard": {
    "id": null,
    "title": "Running API - Monitoreo",
    "tags": ["running-api", "spring-boot"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Uploads por Tipo",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by (type) (rate(running_api_uploads_total[5m]))",
            "legendFormat": "{{type}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Errores de Parseo",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by (type) (rate(running_api_parse_errors_total[5m]))",
            "legendFormat": "{{type}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
      },
      {
        "id": 3,
        "title": "Tiempo de Parseo (ms)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le, type) (rate(running_api_parse_time_bucket[5m])))",
            "legendFormat": "p95 {{type}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
      },
      {
        "id": 4,
        "title": "Actividades Creadas",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(running_api_activities_total)",
            "legendFormat": "Total"
          }
        ],
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 }
      },
      {
        "id": 5,
        "title": "Actividades Eliminadas",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(running_api_activities_deleted_total)",
            "legendFormat": "Total"
          }
        ],
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 16 }
      },
      {
        "id": 6,
        "title": "Llamadas API (req/s)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by (endpoint) (rate(running_api_requests_count[5m]))",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
      },
      {
        "id": 7,
        "title": "Uso de Memoria (MB)",
        "type": "graph",
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{area=\"heap\"} / 1024 / 1024",
            "legendFormat": "Heap"
          },
          {
            "expr": "jvm_memory_used_bytes{area=\"nonheap\"} / 1024 / 1024",
            "legendFormat": "Non-Heap"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 }
      },
      {
        "id": 8,
        "title": "Estado de la Aplicación",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"running-api\"}",
            "legendFormat": "Running API"
          }
        ],
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 }
      }
    ],
    "time": { "from": "now-1h", "to": "now" },
    "refresh": "10s"
  }
}
